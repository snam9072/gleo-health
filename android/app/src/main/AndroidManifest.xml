<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Vehicle SDK 조회 권한 (조회만 — 시트를 움직이는 CONTROL 권한은 선언하지 않는다, 명세 D2) -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- AAOS 표준 속도·기어 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- 화면을 닫아도 기록하는 서비스 (P2) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- S2: Gleo 응답을 받는 시스템 앱을 찾기 위한 패키지 가시성 (Android 11+) -->
    <queries>
        <intent>
            <action android:name="ai.pleos.playground.intent.action.APP_ACTION_RESPONSE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.GleoHealth">

        <!-- 주행 중에도 쓰는 앱이라 주의 분산 최적화(DO) 선언 — 주행 중엔 음성·배지만 (D9) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 주행 기록 서비스: 외부 노출 없음 (S1) -->
        <service
            android:name=".core.HealthService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="In-vehicle trip logging of seat belt and continuous driving time while the driver uses the app" />
        </service>

        <!-- Gleo Interface: App Schema 의 actionCalls (component = service → Gleo 가 우리 패키지를 지정해 sendBroadcast).
             Gleo(시스템 앱)가 보내야 하므로 exported. 보낸 앱 확인·빈도 제한·응답 대상 지정은 GleoGuard (S1·S2) -->
        <receiver android:name=".gleo.GleoActionReceiver" android:exported="true">
            <intent-filter>
                <action android:name="CHECK_SEAT_AND_BELTS" />
                <action android:name="MY_SEAT_HEALTH_SCORE" />
                <action android:name="FIND_REST_STOP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
